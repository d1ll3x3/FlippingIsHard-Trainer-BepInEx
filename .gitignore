## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Rider
.idea/
*.sln.iml

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Build results
bin/
obj/
*.dll
*.exe
*.pdb

# NuGet
*.nupkg
*.snupkg
.nuget/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Local History for Visual Studio
.localhistory/

# BepInEx
plugins/
config/
