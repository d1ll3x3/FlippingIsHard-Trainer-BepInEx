## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Rider
.idea/
*.sln.iml

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Binaries
bin/
obj/
*.dll
*.exe
*.pdb

# Visual Studio / IDE files
*.user
*.suo
*.userosprefs
*.sln
*.csproj.user

# Logs and temp files
*.log
*.tmp
*.temp
.trae/

# Unity / Game specific (if copied by accident)
lib/
*.asset
*.unity3d

# Scripts antiguos o de inyección C++ que ya no se usan
build.bat
setup-libs.bat
setup-libs.ps1
injector.cpp
trainer.cpp

# NuGet
*.nupkg
*.snupkg
.nuget/

# User-specific files
*.rsuser
*.userosscache
*.sln.docstates

# Local History for Visual Studio
.localhistory/

# BepInEx
plugins/
config/
